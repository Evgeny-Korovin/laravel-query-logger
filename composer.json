{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "evgeny-korovin/laravel-query-logger",
    "description": "SQL query logging and inspection tools for Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Godmode\\QueryLogger\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Godmode\\QueryLogger\\Providers\\QueryLoggerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
